{% extends 'base.html.twig' %}
{% block title %}Reset your password{% endblock %}
{% block container %}

    <style>
        .form-group{
            display: flex;
            flex-direction: column;
        }
        label{
            display: flex;
            flex-direction: column;
            text-align: left !important;
        }
    </style>
    <div class="container" style="width: 20em; padding: 4em 0;transform: translate(calc(50vw - 10em));">

        <div class="row">
            <a href="{{ path('homepage') }}" style="width: 100%; text-align: center">
                <img src="{{ asset('logo.png') }}" alt="" style="height: 4em;margin: 0 auto">
            </a>

        </div>
        <div class="row">
            <h2 style="margin:  auto">Reset your Password</h2>
        </div>
         <div class="row" style="justify-content: center;">
             {{ form_start(resetForm) }}
             {{ form_row(resetForm.plainPassword) }}
{#             <button class="btn btn-primary">Reset password</button>#}
             <input type="submit" value="Reset your password" style="margin: 1em auto; display:block;" />
             {{ form_end(resetForm) }}

         </div>

    </div>

{% endblock %}
