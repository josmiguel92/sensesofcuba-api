{#{% extends '@EasyAdmin/default/layout.html.twig' %}#}
{% extends '@EasyAdmin/page/content.html.twig' %}
{#{% extends 'base.html.twig' %}#}

{% block title %}{{ product.id ? 'Edit' : 'Create new'}} Product{% endblock %}


{% block content %}

<link rel="stylesheet" href="{{ asset('assets/bootstrap-select.min.css') }}">
<script src="{{ asset('assets/bs-custom-file-input.min.js') }}"></script>
<script src="{{ asset('assets/bootstrap-select.min.js') }}"></script>

{#{% form_theme form '@EasyAdminBundle:form:bootstrap_4.html.twig' %}#}

    <style>
        .form-group label{
            text-align: left;
        }
        .btn-delete{
            float: left;
        }
    </style>
    <div class="content">
        <section class="content-header ">
            <div class="d-flex flex-row justify-content-between align-content-center w-100">
                <div class="content-header-title">
                    <h1 class="title">    {{ block('title') }}</h1>
                </div>

                <div class="global-actions"></div>
            </div>

        </section>

        <section id="main" class="content-body">
             {{ form_start(form) }}
    <div class="row">
        {% if product.hasImage() %}
            <img src="{{ asset('uploads/images/thumbs/' ~ product.image.imageName)}}" class="img-thumbnail" style="width: 7em; height: 7em; border-radius: 50%; transform: translate(-20%,-30%)">
        {% endif %}
        <h2 style="text-transform: uppercase">{{ product.referenceName }}</h2>
    </div>

    <div class="row">
        <div class="col-md-4">
            Reference Name of the product
        </div>
        <div class="col-md-6">
            {{ form_widget(form.referenceName) }}
        </div>
    </div>

    <div class="row top-padding">
        <div class="col-md-4">
            Show this product to the users at product tree
        </div>
        <div class="col-md-6">
            {{ form_row(form.enabled) }}
        </div>
    </div>

    <div class="row top-padding">
            <div class="col-md-4">
                Product importance, any valor. <br>
                <small>The bigger ones are show first.</small>
            </div>
            <div class="col-md-6">
                {{ form_row(form.importance) }}
            </div>
    </div>



    <div class="row top-padding">
        <div class="col-md-4">
            Parent of this product in the Product tree
            <br>
            <small>Empty for show it at home as category</small>
        </div>
        <div class="col-md-6">
            {{ form_widget(form.parent, {'attr':{ 'data-widget': 'select2', 'class': 'products_parent_select' } }) }}
        </div>
    </div>


    <div class="row top-padding">
        <div class="col-md-4">
            Translations
            <br>
            <small>Add the name and some description in English, German and Spanish for this product. </small>
            <br>
            <aside class="mt-4">
                {{ form_widget(form.isEnglishGlobalTranslation) }}
            </aside>
        </div>
        <div class="col-md-6">
            {{ form_widget(form.translations) }}
        </div>
    </div>


    <hr>

    <div class="row top-padding">
        <div class="col-md-4">
            Product image
            <br>
            <small>Add an image for this product. It will be used to show the product at list.</small>

        </div>
        <div class="col-md-6">
            {{ form_row(form.image.imageFile) }}
        </div>
    </div>

{% if  product.translatedDocument is not null and product.translatedDocument.empty == false %}

    <hr>
    <div class="row">
        <div class="col-md-12">
            <h5>Product PDF File</h5>
        </div>
    </div>
    <div class="row">

        <div class="well m-3 ml-5">
        <p>
            This product <b>"{{ product.referenceName }}"</b> contains associated files:
        </p>
        <ul>
            {% for doc in product.translatedDocument.documents %}
                <li><a href="{{ vich_uploader_asset(doc.file, 'file', 'App\\Entity\\SocFile') }}">{{ doc.lang }}</a></li>
            {% endfor %}
        </ul>
        <p>
            In order to edit this files, or its description, we have to update it on the database.<br>
            Please, save this form to update the product and try again to see the edition form for this documents.
        </p>

        </div>

    </div>
{% endif %}


    {% if  product.alternativeTranslatedDocument is not null and product.alternativeTranslatedDocument.empty == false %}

                <hr>
                <div class="row">
                    <div class="col-md-12">
                        <h5>Alternative Product PDF File (Only for users with alternative prices)</h5>
                    </div>
                </div>
                <div class="row">

                    <div class="well m-3 ml-5">
                        <p>
                            This product <b>"{{ product.referenceName }}"</b> contains associated files configured
                            for show it to some user groups:
                        </p>
                        <ul>
                            {% for doc in product.alternativeTranslatedDocument.documents %}
                                <li><a href="{{ doc.file }}">{{ doc.lang }}</a></li>
                            {% endfor %}
                        </ul>
                        <p>
                            In order to edit this files, or the users tah should see (or not) this content,
                            or its description, we have to update it on the database.<br>
                            Please, save this form to update the product and try again
                            to see the edition form for this documents.
                        </p>

                    </div>

                </div>
            {% endif %}

    <div class="row accordion mb-4 mt-8" id="accordion-{{ form.documentCollection.vars.id }}">
            <div class="col-md-12 mt-5">
                <h5 data-toggle="collapse" data-target="#content-{{ form.documentCollection.vars.id }}"><i class="fa fa-list"></i>
                        Product's docs Collection

                    {% if product.documentCollection.count > 0 %}
                        <span class="badge badge-primary">{{ product.documentCollection.count }}</span>
                    {% endif %}

                    <i class="fa fa-chevron-down"></i>


                </h5>


            </div>

            <div class="col-md-12 collapse collapsed" id="content-{{ form.documentCollection.vars.id }}"
                 data-parent="#accordion-{{ form.documentCollection.vars.id }}">
                <ul class="documentCollection "  data-prototype="{{ form_row(form.documentCollection.vars.prototype)|e('html_attr') }}">
                    {% for document in form.documentCollection %}
                        <li class="row form-group" style="display: flex">{{ form_row(document) }}</li>
                    {% else %}
                        <li id="documentCollection-empty"><p>There aren't any document yet. :(</p></li>
                    {% endfor %}
                </ul>




            </div>
                <div class="col-md-12 pl-12" style="
                        display: flex;
                        justify-content: center">
                    <button type="button" class="btn btn-secondary btn-sm add_item_link documentCollection_btn"
                            data-collection-holder-class="documentCollection">
                        <i class="fa fa-plus-circle"></i>
                        Add a new Document</button>
                </div>



                <style>
                    ul.documentCollection li,
                    .translated-doc{
                        width: 100%;
                        padding-bottom: 1em;
                    }
                    .translated-doc{
                        display: grid;
                        grid-template-columns: repeat(3, 1fr);
                        grid-template-rows:  5em repeat(2, 1fr);
                        grid-column-gap: 0px;
                        grid-row-gap: 0px;
                        gap: 2em;

                    }
                    .translated-doc > .form-group:nth-child(1){
                        grid-area: 1 / 1 / 2 / 3;
                    }
                    .translated-doc > .form-group:nth-child(2){
                        grid-area: 2 / 1 / 4 / 2;
                    }
                    .translated-doc > .form-group:nth-child(3){
                        grid-area: 2 / 2 / 4 / 3;
                    }
                    .translated-doc > .form-group:nth-child(4){
                        grid-area: 2 / 3 / 3 / 4;
                    }
                    .translated-doc > .form-group:nth-child(5){
                        grid-area: 3 / 3 / 4 / 4;
                    }

                    .translated-doc > fieldset {
                        display: flex;
                        flex-direction: column;
                        padding: 1em;
                    }

                    ul.documentCollection li > div > .form-group
                    {max-width: 33.33333%;}
                </style>
                <script>
                    function addFormToCollection($collectionHolderClass) {


                        // Get the ul that holds the collection of tags
                        var $collectionHolder = document.querySelector($collectionHolderClass)

                        // Get the data-prototype explained earlier
                        var prototype = $collectionHolder.dataset.prototype;

                        console.log(prototype)
                        // get the new index
                        var index = Number($collectionHolder.dataset.index);

                        var newForm = prototype;
                        // You need this only if you didn't set 'label' => false in your tags field in TaskType
                        // Replace '__name__label__' in the prototype's HTML to
                        // instead be a number based on how many items we have
                        // newForm = newForm.replace(/__name__label__/g, index);

                        // Replace '__name__' in the prototype's HTML to
                        // instead be a number based on how many items we have
                        newForm = newForm.replace(/__name__/g, index);
                        console.log(newForm)

                        // increase the index with one for the next item
                        $collectionHolder.dataset.index = index + 1;

                        // Display the form in the page in an li, before the "Add a tag" link li
                        var $newFormLi = $('<li class="row form-group" style="display: flex">').append(newForm);
                        // Add the new form at the end of the list
                        console.log($collectionHolder);

                        $collectionHolder.append($newFormLi[0])
                    }

                    jQuery(document).ready(function() {
                        // Get the ul that holds the collection of formTypes
                        var elementSelector = 'ul.documentCollection';
                        var itemsCollection = document.querySelector(elementSelector);

                        // count the current form inputs we have (e.g. 2), use that as the new
                        // index when inserting a new item (e.g. 2)
                        itemsCollection.dataset.index = itemsCollection.querySelectorAll('input').length

                        document.querySelector('.documentCollection_btn.add_item_link').addEventListener('click', function (e){
                            $('#documentCollection-empty').hide();
                            addFormToCollection(elementSelector)
                        })
                    });
                </script>


    </div>


            <div class="flex justify-content-around mt-5 pt-3" style="
            border-top: solid lightslategray 2px;
            display: flex;">
                <button type="submit" class="btn btn-primary action-save">
                    <span class="btn-label">Save changes</span>
                </button>

                {{ form_widget(form.saveAndContinueEditing) }}
                {{ form_widget(form.saveAndAddNotification) }}
            </div>

            {{ form(form._token) }}
            {{ form_end(form) }}

        </section>

            <section class="content-footer" style="position: relative;">
                <div class="form-actions">



                    {% if product.id %}{{ form(deleteForm) }}{% endif %}



                    <a class=" btn btn-link pr-0 action-list" title="" href="{{ path('soc_product_index') }}" target="_self">Back to listing</a>


                </div>


            </section>


    </div>

    <style>
        .card .vich-image img{
            display: none;
        }
        .top-padding{
            padding-top: 2em;
        }
        .vich-image, .vich-image img{
            max-width: 100%;
        }
    </style>

    <script>
        $(document).ready(function () {
            $('.products_parent_select').select2();
            if(typeof bsCustomFileInput != 'undefined')
                bsCustomFileInput.init();

        })
    </script>
    <h2></h2>


{% endblock %}
