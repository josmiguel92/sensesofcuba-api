{% extends 'dash/base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block card_product %}
    <div class="accordion" id="accordion-{{ product.id }}">
        <div class="card" data-id="{{ product.id }}">
            <div class="card-header" id="product-{{ product.id }}">

                <h4>

                    {{ product.name }}
                    {% if product.products | length > 0 %}
                        <small class="badge-primary badge-pill">
                            {{ product.products | length }}
                        </small>
                    {% endif %}

                </h4>

                {% if product.products | length > 0 %}
                    <h3 class="mb-0">
                        <span class="btn btn-link" type="button" data-toggle="collapse" data-target="#children_of-{{ product.id }}"><i class="fa fa-list"></i> View {{ product.products | length }} products inside</span>
                    </h3>
                {% endif %}

            </div>
            <div class="collapse collapsed" id="children_of-{{ product.id }}" data-parent="#accordion-{{ product.id }}">
                <div class="card-body">
                    {% for product in product.products %}
                        {{ block('card_product') }}
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
{% endblock %}

{% block body %}

