<form method="post" action="{{ path('dash_product_delete', {'id': product.id}) }}"
      onsubmit="return confirm('Are you sure you want to delete this product?');"
    class="flex flex-col w-full gap-3">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">

    <div class="align-middle flex gap-4">
        <button class="btn bg-red-600 text-white">Delete</button>

        <p>Delete this product will delete the contained documents and metadata!<br>
            <b>This action can not be undone</b>.
        </p>
    </div>
    <div class="align-left flex items-center">

        <div class="relative inline-block w-10 mr-2 align-middle select-none">
            <div class="form-check">
                <input type="checkbox" id="delete_children" name="delete_children" class="checked:bg-blue-500 outline-none focus:outline-none right-4 checked:right-0 duration-200 ease-in absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer form-check-input" value="1">
                <label class="block overflow-hidden h-6 rounded-full bg-gray-300 cursor-pointer form-check-label" for="delete_children">
                </label>
            </div>
        </div>
        <span class="text-sm">Delete also the children products.</span>
    </div>



</form>
