{% extends 'dash/base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
    <h1>Product</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Metadata</th>
                <td>{{ product.metadata ? product.metadata|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Active</th>
                <td>{{ product.active ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Priority</th>
                <td>{{ product.priority }}</td>
            </tr>
            <tr>
                <th>UniqueId</th>
                <td>{{ product.uniqueId }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('dash_product_index') }}">back to list</a>

    <a href="{{ path('dash_product_edit', {'id': product.id}) }}">edit</a>

    {{ include('dash/product/_delete_form.html.twig') }}
{% endblock %}
