{#{{ dump(form.category.vars.choices) }}#}
<section class="bg-gray-100 bg-opacity-50 w-2/3 mx-auto max-w-4xl">

    {{ form_start(form) }}
    <div class="container mx-auto shadow-md w-full">

        <div class="p-4 bg-gray-100 border-t-2 border-indigo-400 rounded-lg bg-opacity-5">
            <div class="mx-auto md:w-full md:mx-0">
                <div class="inline-flex items-center space-x-4 w-full">
                    <a href="#" class="block relative">
                        <svg class="mx-auto object-cover rounded-full h-16 w-16" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                        </svg>
                    </a>
                    {{ form_widget(form.name, {
                        attr: {
                            'class': 'rounded-lg border-transparent flex-1 appearance-none border border-gray-300 w-full py-2 px-4 bg-white text-gray-700 placeholder-gray-400 shadow-sm text-base focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent',
                            'placeholder': 'Product Name'
                        }
                    }) }}

                    <div class="relative inline-block w-10 mr-2 align-middle select-none">
                        {{ form_widget(form.active, {
                            attr: {
                                class: 'checked:bg-blue-500 outline-none focus:outline-none right-4 checked:right-0 duration-200 ease-in absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer',
                            },
                            label_attr: {
                                class: 'block overflow-hidden h-6 rounded-full bg-gray-300 cursor-pointer'
                            },
                            label: ' '
                        }) }}
                        <span class="text-gray-400 font-thin text-sm">Active</span>
                    </div>


                </div>
            </div>
        </div>
        <div class="space-y-6 bg-white">


            <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b"
                 data-controller="product-category">

                <div class="max-w-sm mx-auto space-y-5 md:w-2/3 flex flex-col items-center"
                     data-product-category-target="category">
                    <h2 class="max-w-sm mx-auto mb-2">
                        Category
                    </h2>

                    {% include 'dash/_components/custom_select.html.twig' with {
                        field: form.category
                    } %}
{#                    {{ form_widget(form.category, { #}
{#                        attr: {#}
{#                            'class': 'rounded-lg border-transparent flex-1 appearance-none border border-gray-300 w-full py-2 px-4 bg-white text-gray-700 placeholder-gray-400 shadow-sm text-base focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent',#}
{#                        },#}
{#                    }) }}#}
                </div>
                <div class="max-w-sm mx-auto space-y-5 md:w-1/3">
                    <h2 class="max-w-sm mx-auto">
                        Parent Product
                    </h2>
                    {{ form_widget(form.parent, {
                        attr: {
                            'class': 'rounded-lg border-transparent flex-1 appearance-none border border-gray-300 w-full py-2 px-4 bg-white text-gray-700 placeholder-gray-400 shadow-sm text-base focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent',
                        }
                    }) }}
                </div>




            </div>


            <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">
                <h2 class="max-w-sm mx-auto md:w-1/3">
                    Title
                </h2>
                {% include 'dash/_components/translatable_input.html.twig' with {langList: product.langList, input: form.title} %}
            </div>
            <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">
                <h2 class="max-w-sm mx-auto md:w-1/3">
                    Description
                </h2>
                {% include 'dash/_components/translatable_input.html.twig' with {langList: product.langList, input: form.description} %}

            </div>

            <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">

                <div class="max-w-sm mx-auto space-y-5 md:w-2/3 flex flex-col items-center">
                    <h2 class="max-w-sm mx-auto mb-2">
                        Use Default Language if possible
                    </h2>
                    <div class="relative inline-block w-10 mr-2 align-middle select-none">
                        {{ form_widget(form.useDefaultLanguage, {
                            attr: {
                                class: 'checked:bg-blue-500 outline-none focus:outline-none right-4 checked:right-0 duration-200 ease-in absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer',
                            },
                            label_attr: {
                                class: 'block overflow-hidden h-6 rounded-full bg-gray-300 cursor-pointer'
                            },
                            label: ' '
                        }) }}
                    </div>
                </div>
                <div class="max-w-sm mx-auto space-y-5 md:w-1/3">
                    <h2 class="max-w-sm mx-auto">
                        Priority
                    </h2>
                    {{ form_widget(form.priority, {
                        attr: {
                            'class': 'rounded-lg border-transparent flex-1 appearance-none border border-gray-300 w-full py-2 px-4 bg-white text-gray-700 placeholder-gray-400 shadow-sm text-base focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent',
                            'placeholder': 'Product Priority'
                        }
                    }) }}
                </div>

            </div>

            <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">

                <div class="w-full mx-auto space-y-5 flex flex-col items-center">
                    <h2 class="max-w-sm mx-auto mb-2">
                        Attachment collection
                    </h2>
                    <div class="relative m-1" data-controller="collectiontype" xmlns="http://www.w3.org/1999/html">
                        {{
                            form_widget(
                                form.attachmentCollection,
                                {
                                    'attr' : {
                                        'class': 'my-3 flex flex-col md:grid md:grid-cols-2 gap-3 w-full p-2'
                                    }
                                }
                            )
                        }}
                        <a href="#" class="btn float-right" data-name="addAttachment">Add attachment</a>

                    </div>

                </div>

            </div>
            <div class="w-full px-4 pb-4 ml-auto text-gray-500 md:w-1/3">
                <button type="submit" class="btn py-2 px-4  bg-blue-600 hover:bg-blue-700 focus:ring-blue-500 focus:ring-offset-blue-200 text-white w-full transition ease-in duration-200 text-center text-base font-semibold shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2  rounded-lg ">
                    {{ button_label|default('Save') }}
                </button>
            </div>
        </div>
    </div>

    {{ form_widget(form) }}
    {{ form_end(form) }}

    {% if product.id != null %}
        <div class="p-4 bg-gray-600 border-t-2 border-red-400 rounded-lg bg-opacity-5"
             x-data="{open: false}"
        >
            <div class="mx-auto md:w-full md:mx-0">
                <div class="w-full flex justify-center"  @click="open = !open"  x-show="!open">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-12 text-red-500">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <p class="self-center">Click to show deletion options</p>

                </div>
                <div class="inline-flex items-center space-x-4 w-full" x-show="open"
                     x-transition:enter="transition ease-out duration-300 origin-top"
                     x-transition:enter-start="opacity-0 transform scale-x-0"
                     x-transition:enter-end="opacity-100 transform scale-x-100">

                    {{ include('dash/product/_delete_form.html.twig') }}

                </div>
            </div>
        </div>
    {% endif %}

</section>



