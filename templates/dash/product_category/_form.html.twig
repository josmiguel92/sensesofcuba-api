
<section class="bg-gray-100 bg-opacity-50 w-2/3 mx-auto max-w-4xl">
    {{ form_start(form) }}
        <div class="container mx-auto shadow-md w-full">

            <div class="p-4 bg-gray-100 border-t-2 border-indigo-400 rounded-lg bg-opacity-5">
                <div class="mx-auto md:w-full md:mx-0">
                    <div class="inline-flex items-center space-x-4 w-full">
                        <a href="#" class="block relative">
                            {% if product_category.id != null and product_category.thumbnailURL != null %}
                                <img alt="category image" src="{{ asset(product_category.thumbnailURL) }}" class="mx-auto object-cover rounded-full h-16 w-16 "/>
                            {% else %}
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="mx-auto object-cover rounded-full h-16 w-16 ">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14v6m-3-3h6M6 10h2a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 0h2a2 2 0 002-2V6a2 2 0 00-2-2h-2a2 2 0 00-2 2v2a2 2 0 002 2zM6 20h2a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2z"/>
                                </svg>
                            {% endif %}
                        </a>
                        {{ form_widget(form.name, {
                            attr: {
                                'class': 'rounded-lg border-transparent flex-1 appearance-none border border-gray-300 w-full py-2 px-4 bg-white text-gray-700 placeholder-gray-400 shadow-sm text-base focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent',
                                'placeholder': 'Category Name'
                            }
                        }) }}

                        <div class="relative inline-block w-10 mr-2 align-middle select-none">
                            {{ form_widget(form.active, {
                                attr: {
                                    class: 'checked:bg-blue-500 outline-none focus:outline-none right-4 checked:right-0 duration-200 ease-in absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer',
                                },
                                label_attr: {
                                    class: 'block overflow-hidden h-6 rounded-full bg-gray-300 cursor-pointer'
                                },
                                label: ' '
                            }) }}
                            <span class="text-gray-400 font-thin text-sm">Active</span>
                        </div>


                    </div>
                </div>
            </div>
            <div class="space-y-6 bg-white">
                <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">
                    <h2 class="max-w-sm mx-auto md:w-1/3">
                        Image
                    </h2>
                    <div class="max-w-sm mx-auto md:w-2/3">
                        <div class=" relative overflow-x-hidden">
                            {{ form_widget(form.imageFile) }}
{#                            <input type="text" id="user-info-email" class=" rounded-lg border-transparent flex-1 appearance-none border border-gray-300 w-full py-2 px-4 bg-white text-gray-700 placeholder-gray-400 shadow-sm text-base focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent" placeholder="Email"/>#}
                        </div>
                    </div>
                </div>
                <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">
                    <h2 class="max-w-sm mx-auto md:w-1/3">
                        Title
                    </h2>
                    {% include 'dash/_components/translatable_input.html.twig' with {langList: product_category.langList, input: form.title} %}
                </div>
                <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">
                    <h2 class="max-w-sm mx-auto md:w-1/3">
                        Description
                    </h2>
                    {% include 'dash/_components/translatable_input.html.twig' with {langList: product_category.langList, input: form.description} %}

                </div>

                <div class="items-center w-full p-4 space-y-4 text-gray-500 md:inline-flex md:space-y-0 border-b">
                    <div class="w-1/2">
                        <h2 class="max-w-sm mx-auto">
                            Priority
                        </h2>
                        {{ form_widget(form.priority, {
                            attr: {
                                'class': 'rounded-lg border-transparent flex-1 appearance-none border border-gray-300 w-full py-2 px-4 bg-white text-gray-700 placeholder-gray-400 shadow-sm text-base focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent',
                                'placeholder': 'Category Name'
                            }
                        }) }}
                    </div>

                    <div class="w-1/2 mx-auto flex flex-col items-center">
                        <h2 class="max-w-sm mx-auto mb-2">
                            Use Default Language if possible
                        </h2>
                        <div class="relative inline-block w-10 mr-2 align-middle select-none">
                            {{ form_widget(form.useDefaultLanguage, {
                                attr: {
                                    class: 'checked:bg-blue-500 outline-none focus:outline-none right-4 checked:right-0 duration-200 ease-in absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer',
                                },
                                label_attr: {
                                    class: 'block overflow-hidden h-6 rounded-full bg-gray-300 cursor-pointer'
                                },
                                label: ' '
                            }) }}
                        </div>
                    </div>



                </div>
                <div class="w-full px-4 pb-4 ml-auto text-gray-500 md:w-1/3">
                    <button type="submit" class="btn py-2 px-4  bg-blue-600 hover:bg-blue-700 focus:ring-blue-500 focus:ring-offset-blue-200 text-white w-full transition ease-in duration-200 text-center text-base font-semibold shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2  rounded-lg ">
                        {{ button_label|default('Save') }}
                    </button>
                </div>
            </div>
        </div>

    {{ form_widget(form) }}
    {{ form_end(form) }}

    {% if product_category.id != null %}
    <div class="p-4 bg-gray-600 border-t-2 border-red-400 rounded-lg bg-opacity-5">
        <div class="mx-auto md:w-full md:mx-0">
            <div class="inline-flex items-center space-x-4 w-full">



                    {{ include('dash/product_category/_delete_form.html.twig') }}


                <p>Delete this category will delete the contained products! This action can not be undone.</p>
            </div>
        </div>
    </div>
    {% endif %}

</section>



