{% extends 'dash/base.html.twig' %}

{% block title %}ProductCategory{% endblock %}

{% block body %}

    <div class="w-full lg:pr-10 lg:py-6 mb-6 lg:mb-0 flex flex-row justify-between">
        <h2 class="text-sm title-font text-gray-500 tracking-widest">Details of Category: {{ product_category.name }}</h2>

        <a  class="text-sm title-font text-gray-500 tracking-widest" href="{{ path('dash_product_category_index') }}">
            Back to list
        </a>
    </div>

    <section class="text-gray-600 body-font overflow-hidden  w-5/6">
        <div class="container px-5 py-12 mx-auto">
            <div class="lg:w-4/5 mx-auto flex flex-wrap">
                <div class="lg:w-1/2 w-full lg:pr-10 lg:py-6 mb-6 lg:mb-0">
                    <h1 class="text-gray-900 text-3xl title-font font-medium mb-4">{{ product_category.name }}</h1>
                    {% include 'dash/_components/translatable_property_display.html.twig' with {
                        propertyValue: product_category.title,
                        propertyName: 'Title',
                        langList: product_category.langList
                    } %}

                    {% include 'dash/_components/translatable_property_display.html.twig' with {
                        propertyValue: product_category.description,
                        propertyName: 'Description',
                        langList: product_category.langList
                    } %}

                    <div class="flex border-t border-gray-200 py-2">
                        <span class="text-gray-500">Products Quantity</span>
                        <span class="ml-auto text-gray-900">{{ product_category.products | length }}</span>
                    </div>

                    <div class="flex border-t border-gray-200 py-2">
                        <span class="text-gray-500">Use default language</span>
                        <span class="ml-auto text-gray-900">{{ product_category.useDefaultLanguage ? 'YES' : 'NO' }}</span>
                    </div>

                    <div class="flex border-t border-b mb-6  border-gray-200 py-2">
                        <span class="text-gray-500">Priority</span>
                        <span class="ml-auto text-gray-900">{{ product_category.priority }}</span>
                    </div>
                    <div class="flex">

                        <a href="{{ path('dash_product_category_edit', {'id': product_category.id}) }}" class="flex ml-auto text-white bg-yellow-500 border-0 py-2 px-6 focus:outline-none hover:bg-yellow-600 rounded">Edit</a>
                        <button class="rounded-full w-10 h-10 bg-gray-200 p-0 border-0 inline-flex items-center justify-center text-gray-500 ml-4">
                            <svg fill="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-5 h-5" viewBox="0 0 24 24">
                                <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                {% if product_category.imageName != null %}
                    <img alt="{{ product_category.name }}" class="lg:w-1/2 w-full lg:h-auto h-64 object-cover object-center rounded"
                         src="{{ asset(product_category.thumbnailURL) }}">
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
