{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.0",
        "ext-ctype": "*",
        "ext-exif": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "api-platform/core": "^2.6.5",
        "a2lix/translation-form-bundle": "^3.0",
        "composer/package-versions-deprecated": "1.11.99.1",
        "doctrine/annotations": "^1.13.1",
        "doctrine/doctrine-bundle": "^2.4.2",
        "doctrine/doctrine-migrations-bundle": "^3.1",
        "doctrine/orm": "^2.9",
        "easycorp/easyadmin-bundle": "^2.3",
        "erusev/parsedown": "^1.7",
        "knplabs/doctrine-behaviors": "^2.2",
        "lexik/jwt-authentication-bundle": "^v2.12.1",
        "nelmio/cors-bundle": "^2.1",
        "phpdocumentor/reflection-docblock": "^5.2",
        "sensio/framework-extra-bundle": "^5.6",
        "symfony/asset": "^5.3",
        "symfony/console": "^5.3",
        "symfony/dotenv": "^5.3",
        "symfony/expression-language": "^5.3",
        "symfony/flex": "^1.4",
        "symfony/form": "^5.3",
        "symfony/framework-bundle": "^5.3",
        "symfony/mailer": "^5.3",
        "symfony/messenger": "^5.3",
        "symfony/mime": "^5.3",
        "symfony/monolog-bundle": "^3.7",
        "symfony/profiler-pack": "^1.0",
        "symfony/property-access": "^5.3",
        "symfony/property-info": "^5.3",
        "symfony/proxy-manager-bridge": "^5.3",
        "symfony/routing": "^5.3",
        "symfony/security-bundle": "^5.3",
        "symfony/serializer": "^5.3",
        "symfony/twig-bundle": "^5.3",
        "symfony/twig-pack": "^1.0",
        "symfony/validator": "^5.3",
        "symfony/webpack-encore-bundle": "^1.11",
        "symfony/yaml": "^5.3",
        "symfonycasts/reset-password-bundle": "^1.9",
        "twig/cssinliner-extra": "^3.3",
        "twig/inky-extra": "^3.3",
        "twig/markdown-extra": "^3.0",
        "vich/uploader-bundle": "^1.15"
    },
    "require-dev": {
        "symfony/browser-kit": "v5.3.0",
        "symfony/css-selector": "v5.3.0",
        "symfony/maker-bundle": "^1.33",
        "symfony/phpunit-bridge": "^5.3"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform": {
            "php": "8.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.3.*"
        }
    },
    "name": "habanatech/tourcomcuba-infonet",
    "description": "An Infonet website for Senses of Cuba, by Tourcom"
}
